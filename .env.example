# Midnight network for wallet.connect(...)
# preview | preprod | undeployed | mainnet
VITE_MIDNIGHT_NETWORK=preprod

# Deployed contract bound on startup (also persisted when bound via the Deploy page)
# VITE_CONTRACT_ADDRESS=ca572dfc83d9eef244fdecc3becb0cc03ed56f6590f28cceaabee5c9688ba3ed

# Blockfrost project ID (required for preprod since the legacy indexer was decommissioned 2026-10-09)
# Sign up free at https://blockfrost.io — select "Midnight Preprod" when creating a project.
# VITE_BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

# Optional overrides (wallet getConfiguration() is the source of truth at runtime).
# If set, these take priority over both the wallet config and Blockfrost defaults.
# VITE_MIDNIGHT_NODE=https://rpc.midnight-preprod.blockfrost.io
# VITE_MIDNIGHT_INDEXER=https://midnight-preprod.blockfrost.io/api/v0
# VITE_MIDNIGHT_INDEXER_WS=wss://midnight-preprod.blockfrost.io/api/v0/ws

# Local undeployed stack example:
# VITE_MIDNIGHT_NETWORK=undeployed
# VITE_MIDNIGHT_NODE=http://localhost:9944
# VITE_MIDNIGHT_INDEXER=http://localhost:8088/api/v4/graphql
# VITE_MIDNIGHT_INDEXER_WS=ws://localhost:8088/api/v4/graphql/ws
# VITE_MIDNIGHT_PROOF_SERVER=http://localhost:6300
